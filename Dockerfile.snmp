# syntax=docker/dockerfile:1
FROM python:3.12-slim

# snmpsim-lextudio is the maintained fork of snmpsim
RUN pip install --no-cache-dir snmpsim-lextudio

WORKDIR /data

# SNMP Printer-MIB data (community "public"), embedded so no extra file is needed.
# OIDs must stay sorted. Same content as public.snmprec.
COPY <<'EOF' /data/public.snmprec
1.3.6.1.2.1.1.1.0|4|Fake Printer 9000 MFP
1.3.6.1.2.1.1.3.0|67|123456
1.3.6.1.2.1.1.5.0|4|FAKEPRN01
1.3.6.1.2.1.25.3.2.1.3.1|4|Fake Printer 9000
1.3.6.1.2.1.25.3.2.1.5.1|2|2
1.3.6.1.2.1.25.3.5.1.1.1|2|3
1.3.6.1.2.1.43.5.1.1.16.1|4|Fake Printer 9000
1.3.6.1.2.1.43.11.1.1.6.1.1|4|Black Toner Cartridge
1.3.6.1.2.1.43.11.1.1.8.1.1|2|10000
1.3.6.1.2.1.43.11.1.1.9.1.1|2|7500
EOF

# strip Windows line endings if this file was checked out with CRLF
RUN sed -i 's/\r$//' /data/public.snmprec

EXPOSE 161/udp

# snmpsim binds UDP 161 as root, then must drop to an unprivileged user (it refuses to run otherwise).
# It also writes index files, so give that user a writable cache dir.
RUN mkdir -p /tmp/snmpsim-cache && chmod 777 /tmp/snmpsim-cache
CMD ["snmpsim-command-responder", "--data-dir=/data", "--cache-dir=/tmp/snmpsim-cache", \
     "--agent-udpv4-endpoint=0.0.0.0:161", "--process-user=nobody", "--process-group=nogroup"]